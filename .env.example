# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_teacher?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-key-at-least-32-chars"

# AI Provider (choose one)
OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# AI_PROVIDER="openai" # or "groq"

# Storage (for production - Vercel Blob or S3)
# BLOB_READ_WRITE_TOKEN=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION="us-east-1"

# Optional
NODE_ENV="development"
