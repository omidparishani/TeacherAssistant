# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_teacher?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-key-at-least-32-chars"

# AI (اختیاری — می‌توانید از داشبورد Provider تنظیم کنید)
# GROQ_API_KEY="gsk_..."
# OPENAI_API_KEY="sk-..."
# AI_MODEL="openai/gpt-oss-20b"

# Vercel Blob — ضروری برای آپلود PDF روی Vercel
# از Vercel Dashboard → Storage → Create Blob Store → کپی token
BLOB_READ_WRITE_TOKEN=""

NODE_ENV="development"
